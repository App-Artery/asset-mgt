# Copy to .env for local development. NEVER commit real values.
# Every variable the app or its tooling reads is enumerated here.

# Postgres connection string.
# Local dev: the docker compose Postgres (host port 5433). Production: the
# Neon POOLED connection string (eu-central-1) injected by the Vercel <-> Neon
# integration.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/asset_mgt"

# Auth.js JWT/cookie signing secret. Generate: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Resend API key (https://resend.com/api-keys) for magic-link email.
AUTH_RESEND_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Verified sender for auth email. The free-tier default sender
# (onboarding@resend.dev) only delivers to the Resend account owner — a
# verified sending domain is REQUIRED before magic links reach staff inboxes.
AUTH_EMAIL_FROM="Asset Register <assets@example.com>"

# Real-DB integration tests run ONLY when this is set (skipIf pattern).
# Never point it at a database whose data you care about.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/asset_mgt_test"

# Only needed when running the production build locally (`next start`) —
# Auth.js auto-trusts the host in dev mode and on Vercel. Do not set in
# production.
# AUTH_TRUST_HOST=true
