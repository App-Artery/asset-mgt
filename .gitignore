# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# mutation testing — Stryker's sandbox holds full copies of the source tree with
# `// @ts-nocheck` injected at the top of every file. Untracked AND unlinted:
# see the ignores in eslint.config.mjs and the exclude in tsconfig.json, because
# .husky/pre-push runs a full-repo `pnpm lint && pnpm typecheck` that would
# otherwise fail for everyone who has ever run the mutation suite.
/.stryker-tmp/
/reports/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example is the only committed env file
.env*
!.env.example

# real staff data (Kenya DPA) — only scripts/staff.example.csv (synthetic)
# may ever be committed
seed-data/

# vercel
.vercel

# local agent configuration and memory — machine-specific notes about this
# developer's setup, never repo content
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts
.pnpm-store
